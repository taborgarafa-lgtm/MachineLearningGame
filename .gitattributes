# ---------------------------------------------------------------
# .gitattributes — normalizacion de saltos de linea
# Fija el comportamiento en el repo para que sea identico en las
# maquinas de todos, sin depender de core.autocrlf local.
# ---------------------------------------------------------------

# Deteccion automatica de archivos de texto
* text=auto

# Archivos YAML de Unity: siempre LF, para que los diffs sean limpios
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.meta       text eol=lf
*.mat        text eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.physicsMaterial2D text eol=lf
*.scenetemplate     text eol=lf
*.inputactions      text eol=lf

# Codigo y configuracion
*.cs     text diff=csharp eol=lf
*.shader text eol=lf
*.json   text eol=lf
*.txt    text eol=lf
*.md     text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf

# Binarios: Git no debe tocarlos nunca
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.psd  binary
*.mp3  binary
*.wav  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
*.fbx  binary
*.dll  binary
*.unitypackage binary
